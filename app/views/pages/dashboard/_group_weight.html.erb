<%# locals: (weight:, color:) %>

<% effective_weight = weight.presence || 0 %>

<div class="w-full flex items-center justify-between gap-2">
  <div class="w-16 h-1.5 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
    <div class="h-full rounded-full transition-all duration-300" 
         style="width: <%= [effective_weight, 100].min %>%; background-color: <%= color %>;"></div>
  </div>
  <p class="text-sm font-mono"><%= number_to_percentage(effective_weight, precision: 2) %></p>
</div>
