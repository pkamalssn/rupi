<!DOCTYPE html>
<html>
  <head>
    <title><%= @chat.title %> - RUPI Chat Export</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        line-height: 1.6;
        color: #1a1a1a;
        padding: 40px;
        max-width: 800px;
        margin: 0 auto;
        background: white;
      }
      
      @media print {
        body {
          padding: 20px;
        }
        
        .no-print {
          display: none !important;
        }
        
        .message {
          page-break-inside: avoid;
        }
      }
      
      .header {
        text-align: center;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 2px solid #eee;
      }
      
      .header h1 {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 8px;
        color: #111;
      }
      
      .header .subtitle {
        font-size: 14px;
        color: #666;
      }
      
      .header .rupi-logo {
        font-size: 28px;
        font-weight: 700;
        background: linear-gradient(135deg, #12B76A, #FACC15);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 16px;
      }
      
      .print-btn {
        display: inline-block;
        background: #12B76A;
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        margin: 20px 0;
        cursor: pointer;
        border: none;
        font-size: 16px;
      }
      
      .print-btn:hover {
        background: #10A861;
      }
      
      .back-btn {
        display: inline-block;
        color: #666;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        margin: 20px 0 20px 10px;
        cursor: pointer;
        border: 1px solid #ddd;
        font-size: 16px;
        background: white;
      }
      
      .back-btn:hover {
        background: #f5f5f5;
      }
      
      .messages {
        margin-top: 30px;
      }
      
      .message {
        margin-bottom: 24px;
        padding: 16px 20px;
        border-radius: 12px;
      }
      
      .message.user {
        background: #f0f9f4;
        border-left: 4px solid #12B76A;
      }
      
      .message.assistant {
        background: #f7f7f8;
        border-left: 4px solid #6366f1;
      }
      
      .message-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 14px;
      }
      
      .message.user .message-header {
        color: #047857;
      }
      
      .message.assistant .message-header {
        color: #4f46e5;
      }
      
      .message-time {
        font-weight: 400;
        color: #999;
        font-size: 12px;
        margin-left: auto;
      }
      
      .message-content {
        font-size: 15px;
        color: #333;
        white-space: pre-wrap;
        word-wrap: break-word;
      }
      
      .message-content p {
        margin-bottom: 12px;
      }
      
      .message-content p:last-child {
        margin-bottom: 0;
      }
      
      .footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #eee;
        text-align: center;
        font-size: 12px;
        color: #999;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <div class="rupi-logo">RUPI</div>
      <h1><%= @chat.title %></h1>
      <p class="subtitle">
        Exported on <%= Time.current.strftime('%B %d, %Y at %I:%M %p IST') %>
      </p>
      <div class="no-print">
        <button class="print-btn" onclick="window.print()">🖨️ Print / Save as PDF</button>
        <button class="back-btn" onclick="window.close()">← Close</button>
      </div>
    </div>
    
    <div class="messages">
      <% @chat.conversation_messages.ordered.each do |message| %>
        <div class="message <%= message.is_a?(UserMessage) ? 'user' : 'assistant' %>">
          <div class="message-header">
            <span><%= message.is_a?(UserMessage) ? '👤 You' : '🤖 RUPI' %></span>
            <span class="message-time"><%= message.created_at.strftime('%b %d, %Y %I:%M %p') %></span>
          </div>
          <div class="message-content">
            <%= simple_format(message.content) %>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="footer">
      <p>Chat ID: <%= @chat.id %></p>
      <p>Generated by RUPI - Your Personal Finance AI Assistant</p>
      <p>rupiapp.in</p>
    </div>
  </body>
</html>
